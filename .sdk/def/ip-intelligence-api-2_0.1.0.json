{
  "openapi": "3.0.3",
  "info": {
    "title": "IP Intelligence API",
    "description": "IPQuery provides a straightforward API for IP intelligence, allowing developers to retrieve geolocation and other information based on IP addresses. It features a free tier and does not require an API key, making it easy to integrate into applications.",
    "version": "1.0.0",
    "contact": {
      "url": "https://github.com/l0v3m0n3y/ipquery"
    }
  },
  "servers": [
    {
      "url": "https://api.ipquery.io",
      "description": "Production server"
    }
  ],
  "paths": {
    "/{ip}": {
      "get": {
        "summary": "Get IP information",
        "description": "Retrieves geolocation and intelligence information for a specified IP address. No API key required.",
        "operationId": "getIpInfo",
        "tags": [
          "IP Intelligence"
        ],
        "parameters": [
          {
            "name": "ip",
            "in": "path",
            "required": true,
            "description": "The IP address to query (IPv4 or IPv6)",
            "schema": {
              "type": "string",
              "example": "1.1.1.1"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with IP information",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ip": {
                      "type": "string",
                      "description": "The queried IP address",
                      "example": "1.1.1.1"
                    },
                    "country": {
                      "type": "string",
                      "description": "Country name",
                      "example": "Australia"
                    },
                    "country_code": {
                      "type": "string",
                      "description": "ISO 3166-1 alpha-2 country code",
                      "example": "AU"
                    },
                    "city": {
                      "type": "string",
                      "description": "City name",
                      "example": "Sydney"
                    },
                    "region": {
                      "type": "string",
                      "description": "Region or state name",
                      "example": "New South Wales"
                    },
                    "latitude": {
                      "type": "number",
                      "format": "double",
                      "description": "Geographical latitude",
                      "example": -33.8688
                    },
                    "longitude": {
                      "type": "number",
                      "format": "double",
                      "description": "Geographical longitude",
                      "example": 151.2093
                    },
                    "timezone": {
                      "type": "string",
                      "description": "Timezone identifier",
                      "example": "Australia/Sydney"
                    },
                    "isp": {
                      "type": "string",
                      "description": "Internet Service Provider",
                      "example": "Cloudflare, Inc."
                    },
                    "org": {
                      "type": "string",
                      "description": "Organization name",
                      "example": "APNIC and Cloudflare DNS Resolver project"
                    },
                    "as": {
                      "type": "string",
                      "description": "Autonomous System information",
                      "example": "AS13335 Cloudflare, Inc."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - Invalid IP address format",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Invalid IP address format"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "IP address not found or no data available",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "IP address not found"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Rate limit exceeded"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Internal server error"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "IP Intelligence",
      "description": "Operations for retrieving IP geolocation and intelligence data"
    }
  ],
  "externalDocs": {
    "description": "API Documentation on GitHub",
    "url": "https://github.com/l0v3m0n3y/ipquery"
  }
}
